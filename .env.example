# Copy this file to .env and fill in real values.
# SHOPIFY_API_KEY, SHOPIFY_API_SECRET, SCOPES, and SHOPIFY_APP_URL are
# injected automatically by `shopify app dev` / `shopify app deploy` and
# only need to be set here for production hosting (e.g. `npm start`).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_customers,write_customers,read_orders
SHOPIFY_APP_URL=
SHOP_CUSTOM_DOMAIN=

# The single Tulola shop domain — used by unauthenticated.admin() for
# server-to-server Admin API calls (customer sync, segment tagging).
# Format: yourstore.myshopify.com (no https://)
SHOPIFY_SHOP_DOMAIN=

# Local dev: file:dev.sqlite — Docker/prod: file:./data/prod.sqlite (see docker-compose.prod.yml)
DATABASE_URL=file:dev.sqlite

# tulola-integration — this app calls its API (pushing computed segments/
# customers isn't right; it's the other way: tulola-integration calls INTO
# this app's api.* routes, and this app calls OUT to tulola-integration to
# forward Shopify order webhooks). See AGENTS.md for the exact shape.
TULOLA_INTEGRATION_URL=
TULOLA_INTEGRATION_ACCESS_TOKEN=

# Shared secret tulola-integration must send (as x-access-token, matching
# its own requireAccessToken.ts convention) when calling this app's api.*
# routes. Generate a random value, not the same as SHOPIFY_API_SECRET.
BRIDGE_SERVICE_TOKEN=
